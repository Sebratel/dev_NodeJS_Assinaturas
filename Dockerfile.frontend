# Serviço `frontend` da stack: as telas (build do Vite) num nginx sem root, que repassa /api para o `backend`
# pela rede interna da stack (mesma origem: sem CORS e sem a API exposta no servidor).
# Referência: dev_ReactJS_Splitters (Dockerfile.frontend). Config do nginx em docker/nginx-frontend.conf.

# ── Stage 1: build das telas ─────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app/web

# Dependências em camada separada: só baixa de novo quando o package*.json muda.
COPY web/package*.json ./
RUN npm ci --no-audit --no-fund

# VITE_* vão para o JavaScript do navegador NO BUILD (públicos por design, nunca segredo).
# Mudar qualquer um exige rebuild da stack, não só restart.
ARG VITE_API_BASE_URL=/api
ARG VITE_AUTH_ENABLED=true
ARG VITE_AUTH_HOSTED_DOMAIN=sebratel.com.br
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_AUTH_DOMAIN=
ARG VITE_FIREBASE_PROJECT_ID=
ARG VITE_FIREBASE_APP_ID=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_AUTH_ENABLED=$VITE_AUTH_ENABLED \
    VITE_AUTH_HOSTED_DOMAIN=$VITE_AUTH_HOSTED_DOMAIN \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID

COPY web/ ./
RUN npm run build

# ── Stage 2: runtime ─────────────────────────────────────────────
# nginx-unprivileged: roda como usuário nginx (uid 101), escuta 8080. Alpine traz o wget do healthcheck.
FROM nginxinc/nginx-unprivileged:1.28-alpine

ARG APP_VERSION=dev
LABEL org.opencontainers.image.version=$APP_VERSION

COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html

EXPOSE 8080
