# Desenvolvimento local. Em produção (Portainer) as variáveis vêm do docker-compose.portainer.yml
# e os segredos do painel Environment da stack. Ver README › Deploy no Portainer.

# --- Servidor ---
PORT=3180
# Local: 127.0.0.1. No container: 0.0.0.0 (o compose já define).
HOST=127.0.0.1
# Build do frontend servido pela API (SPA). Sem a pasta, a API sobe só com /api.
WEB_DIST_PATH=../web/dist
# info | debug | warn | error
LOG_LEVEL=info
# Requisição acima disso sai como `slow request` (warn).
SLOW_REQUEST_MS=5000

# --- Login (SSO, padrao-login-sso) ---
# true em qualquer ambiente compartilhado. false só na máquina de dev: toda requisição vira o usuário "local".
AUTH_ENABLED=false
# Projeto Firebase deste sistema (um por sistema).
FIREBASE_PROJECT_ID=authentication-assinaturas
AUTH_ALLOWED_DOMAIN=sebratel.com.br
# Quem pode usar o sistema, separado por vírgula. Vazio = ninguém.
AUTH_ADMIN_EMAILS=
# Cópia dos certificados do Google (login continua validando se o Google ficar inacessível).
FIREBASE_CERTS_CACHE_PATH=../data/firebase-certs.json

# --- Banco ---
# sqljs = arquivo local (desenvolvimento) | mariadb = produção (tabelas por migration ao subir)
DB_TYPE=sqljs
DB_SQLJS_PATH=../data/assinaturas.sqlite
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Diretório (AD) ---
# ldap = servidor (conta de leitura) | windows = máquina de dev no domínio, AD ao vivo com o login do Windows
# (chama scripts/exportar-ad.ps1, sem senha) | snapshot = só o arquivo, sem tocar no AD
DIRECTORY_SOURCE=snapshot
DIRECTORY_SNAPSHOT_PATH=../data/ad-snapshot.json
DIRECTORY_SYNC_INTERVAL_MINUTES=10
AD_URL=ldap://10.0.11.251
AD_BASE_DN=DC=corp,DC=sebratel,DC=com,DC=br
# Conta só de leitura. Atenção: hoje toda conta do domínio é administradora (Domain Users em Administrators).
AD_BIND_USER=
AD_BIND_PASSWORD=

# --- Google ---
GOOGLE_PROJECT_ID=integracoes-senior-ad-gwa
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=113892655020718818138
# Chave da conta de serviço: OU o caminho do arquivo (fora do repositório)...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# ...OU o conteúdo do JSON (puro ou em base64). É o que vai no painel do Portainer. Tem precedência sobre o arquivo.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# E-mail do domínio usado para testar a delegação (só pede token, não grava).
GOOGLE_DELEGATION_TEST_USER=
# Semente da lista de teste (só na primeira subida). Depois, quem recebe gravação é decidido em Configurações › Google.
GOOGLE_APPLY_ALLOWLIST=

# --- Assinatura ---
# Imagens precisam de endereço público (o Gmail busca de fora). Trocar por hospedagem própria antes de produção.
SIGNATURE_IMAGE_BASE_URL=https://raw.githubusercontent.com/Sebratel/dev_Sebratel_Images/main/

# --- Elastic APM (observabilidade-backend) ---
# Vazio = agente desligado (dev local e CI). Produção: https://apm.sebratel.net.br
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SERVICE_NAME=assinaturas-backend
ELASTIC_APM_ENVIRONMENT=development
