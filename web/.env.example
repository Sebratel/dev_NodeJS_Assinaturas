# Tudo que começa com VITE_ vai para o JavaScript do navegador e é gravado NO BUILD:
# mudar aqui exige rebuild (no Docker: build.args no compose). Nunca colocar segredo.

# Endereço da API. Em desenvolvimento o Vite repassa /api para 127.0.0.1:3180 (vite.config.ts).
VITE_API_BASE_URL=/api

# Login com Google (padrao-login-sso). Igual ao AUTH_ENABLED da API: false só no desenvolvimento local.
VITE_AUTH_ENABLED=false
# Só filtra o seletor de contas do Google; quem valida o domínio é a API.
VITE_AUTH_HOSTED_DOMAIN=sebratel.com.br

# Projeto Firebase deste sistema: authentication-assinaturas (um projeto por sistema).
# Console Firebase > Configurações do projeto > Seus apps > Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
